<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CandidQV.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CandidQV"
    xmlns:views="clr-namespace:CandidQV.Views"
    Title="CandidQV">

    <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />

    <FlyoutItem Title="Airlines"
            Icon="dog.png">
            <ShellContent
            Title="Airlines"
            ContentTemplate="{DataTemplate views:AirlinesPage}"
            Route="Airlines" />
        </FlyoutItem>
    <FlyoutItem Title="Employees"
            Icon="dog.png">
        <ShellContent
            Title="Employees"
            ContentTemplate="{DataTemplate views:EmployeesPage}"
            Route="Employees" />
    </FlyoutItem>
</Shell>
