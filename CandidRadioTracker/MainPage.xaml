<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             x:Class="CandidRadioTracker.MainPage">

    <VerticalStackLayout Padding="20" Spacing="10">

        <!-- Top Row: DatePicker + Add Button -->
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start">
            <DatePicker x:Name="datePicker"
                        Date="{Binding SelectedDate}"
                        Format="MMMM dd, yyyy"
                        HorizontalOptions="FillAndExpand"
                        Margin="0,0,10,0" />

            <buttons:SfButton Text="Add"
                                  Command="{Binding AddRadioLogCommand}"
                                  WidthRequest="80"
                                  HeightRequest="40"
                                  CornerRadius="8"
                                  BackgroundColor="#007AFF"
                                  TextColor="White" 
                                  Grid.Column="1"/>
        </Grid>

        <!-- CollectionView of Radiologs -->
        <CollectionView ItemsSource="{Binding RadioLogs}"
                        SelectionMode="None"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Timestamp, StringFormat='{0:MMM dd, yyyy h:mm tt}'}"
                                   FontSize="10" TextColor="#888" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
