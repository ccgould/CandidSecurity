<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CandidBritishAirways.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CandidBritishAirways"
    xmlns:views="clr-namespace:CandidBritishAirways.Views"
    Title="CandidBritishAirways">

    <TabBar>

        <Tab Title="New Report" Icon="home.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Reports" Icon="report.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:ReportPage}"
                Route="ReportPage" />
        </Tab>

    </TabBar>
</Shell>
