<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionInputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="CandidQVmMulti.View.Pages.VouchersPage"
             BackgroundColor="#F8FAFC"
             x:Name="vouchersPage"
             xmlns:converter="clr-namespace:CandidQVmMulti.View.Converters">

    <ContentPage.Resources>
        <converter:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converter:IntToStatusConverter x:Key="IntToStatusConverter"/>
        <converter:TicksToStringTimeConverter x:Key="TicksToStringTimeConverter"/>
        <converter:TickToDateConverter x:Key="TickToDateConverter"/>
    </ContentPage.Resources>

    <OnPlatform x:TypeArguments="View">
        <On Platform="Android,iOS">
            <Grid>
                <ScrollView>
                    <StackLayout Padding="16" Spacing="24">

                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="Voucher Management" FontAttributes="Bold" FontSize="20" TextColor="Black" Grid.Column="0" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                <Image Source="bell_icon.png" HeightRequest="24" WidthRequest="24" />
                                <Image Source="settings_icon.png" HeightRequest="24" WidthRequest="24" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Page Title -->
                        <StackLayout>
                            <Label Text="Wheelchair Vouchers" FontAttributes="Bold" FontSize="24" TextColor="Black" />
                            <Label Text="Manage and track assistance vouchers" FontSize="16" TextColor="#6B7280" />
                        </StackLayout>

                        <!-- Filter Card -->
                        <Frame BackgroundColor="#F9FAFB" BorderColor="#E5E7EB" CornerRadius="12" Padding="16">
                            <StackLayout Spacing="16">
                                <Label Text="Filter Vouchers" FontAttributes="Bold" FontSize="18" />

                                <VerticalStackLayout Spacing="8">
                                    <syncfusionButtons:SfButton IsVisible="{OnPlatform Android=False}" Text="Export CSV" Background="#F3F4F6" TextColor="Black" Padding="16,0" CornerRadius="6" Command="{Binding ExportCommand}"/>
                                    <syncfusionButtons:SfButton IsVisible="{OnPlatform Android=False}" Text="Add Voucher" Background="#111111" TextColor="White" Padding="16,0" CornerRadius="6" Command="{Binding AddCommand}"/>
                                    <syncfusionButtons:SfButton Text="Clear Filters" Background="#111111" TextColor="White" Padding="16,0" CornerRadius="6" Command="{Binding ClearFiltersCommand}"/>
                                </VerticalStackLayout>

                                <SearchBar Placeholder="Search passengers, employees..." Text="{Binding SearchText}" TextColor="Black"/>

                                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <!-- Start Date -->
                                    <StackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Start Date" FontSize="16" TextColor="#374151"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker BackgroundColor="White" Date="{Binding StartDate,Mode=TwoWay}" TextColor="Black"/>
                                            <Image Grid.Column="1" Source="calendar_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="8,0"/>
                                        </Grid>
                                    </StackLayout>

                                    <!-- End Date -->
                                    <StackLayout Grid.Row="1" Grid.Column="2" Spacing="4">
                                        <Label Text="End Date" FontSize="16" TextColor="#374151"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker BackgroundColor="White" Date="{Binding EndDate}" TextColor="Black"/>
                                            <Image Grid.Column="1" Source="calendar_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="8,0"/>
                                        </Grid>
                                    </StackLayout>
                               
                                </HorizontalStackLayout>

                                <Picker
                                    ItemsSource="{Binding Airlines}"
                                    SelectedItem="{Binding SelectedAirline, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding Name}"
                                    Title="Select airline"
                                    TextColor="Black"
                                    BackgroundColor="White"/>

                                <Border IsVisible="{Binding IsPanelVisible}" Background="LightBlue" Padding="10" StrokeShape="RoundRectangle 20" x:Name="selectionNotice">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding SelectedText}" 
                                           VerticalOptions="Center" 
                                           TextColor="DarkBlue" 
                                           FontAttributes="Bold"/>

                                            <Label Text="Clear Selected" 
                                           Grid.Column="1" 
                                           VerticalOptions="Center" 
                                           TextDecorations="Underline"
                                           TextColor="Blue"/>

                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" 
                                            Text="Sign Selected" 
                                            HeightRequest="60"
                                            Margin="5" 
                                            TextColor="White"
                                            Command="{Binding SignSelectedCommand}"/>
                                    </Grid>
                                </Border>

                            </StackLayout>
                        </Frame>

                        <!-- Vouchers List -->
                        <Label Text="{Binding VouchersCount, StringFormat='Vouchers ({0})'}" FontAttributes="Bold" FontSize="18" />
                        <Label Text="List of wheelchair assistance vouchers" FontSize="14" TextColor="#6B7280" />

                        <!--<CollectionView ItemsSource="{Binding Vouchers}" x:Name="VouchersDataGrid">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12" Margin="8" CornerRadius="12" BorderColor="#E5E7EB">
                                    <StackLayout Spacing="4">
                                        <Label Text="{Binding PassengerName}" FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding Airline}" FontSize="14" />
                                        <Label Text="{Binding FullFlightNumber}" FontSize="14" />
                                        <Label Text="{Binding Status, Converter={StaticResource IntToStatusConverter}}" FontSize="14" BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" Padding="4" />
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                            <syncfusionButtons:SfButton
                                            ImageSource="edit.png"
                                            ShowIcon="True"
                                            ImageAlignment="Default"
                                            Background="#F3F4F6"
                                            TextColor="Black"
                                            HeightRequest="28"
                                            WidthRequest="28"
                                            Padding="2"
                                            CornerRadius="6"
                                            Command="{Binding Path=BindingContext.EditCommand, Source={x:Reference VouchersDataGrid}}"
                                            CommandParameter="{Binding .}" />
                                            <syncfusionButtons:SfButton
                                            ImageSource="trash.png"
                                            ImageAlignment="Default"
                                            ShowIcon="True"
                                            Background="#F3F4F6"
                                            TextColor="Black"
                                            HeightRequest="28"
                                            WidthRequest="28"
                                            Padding="2"
                                            CornerRadius="6"
                                            Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference VouchersDataGrid}}"
                                            CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>-->

                        <syncfusion:SfDataGrid
                        x:Name="VouchersDataGrid"
                        ItemsSource="{Binding Vouchers}"                        
                        GridLinesVisibility="Horizontal"
                        AutoGenerateColumnsMode="None"
                        HeaderGridLinesVisibility="Horizontal"
                        RowHeight="60"
                        SelectionMode="Single"
                        SelectionUnit="Row"
                        NavigationMode="Row"
                        Margin="0,0,0,0"
                        CellTapped="VouchersDataGrid_CellTapped"
                        >
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:DataGridCheckBoxColumn HeaderText="Select" MappingName="IsSelected"/>
                                <syncfusion:DataGridTextColumn HeaderText="Date" MappingName="Date" DisplayBinding="{Binding Path=Date,Converter={StaticResource TickToDateConverter}}"/>
                                <syncfusion:DataGridTextColumn HeaderText="Passenger" MappingName="PassengerName"/>
                                <syncfusion:DataGridTextColumn HeaderText="Flight" MappingName="FullFlightNumber"/>
                                <syncfusion:DataGridTemplateColumn HeaderText="Status" ColumnWidthMode="LastColumnFill" MappingName="Status">
                                    <syncfusion:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                            Padding="4"
                                            Stroke="#E5E7EB"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                                <Label
                                                Text="{Binding Status, Converter={StaticResource IntToStatusConverter}}"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                TextColor="Black"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </syncfusion:DataGridTemplateColumn.CellTemplate>
                                </syncfusion:DataGridTemplateColumn>
                                <syncfusion:DataGridTemplateColumn HeaderText="Actions" ColumnWidthMode="LastColumnFill">
                                    <syncfusion:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                                <syncfusionButtons:SfButton
                                                ImageSource="edit.png"
                                                ShowIcon="True"
                                                ImageAlignment="Default"
                                                Background="#F3F4F6"
                                                TextColor="Black"
                                                HeightRequest="28"
                                                WidthRequest="28"
                                                Padding="2"
                                                CornerRadius="6"
                                                Command="{Binding Path=BindingContext.EditCommand, Source={x:Reference VouchersDataGrid}}"
                                                CommandParameter="{Binding .}" />
                                                <syncfusionButtons:SfButton
                                                ImageSource="trash.png"
                                                ImageAlignment="Default"
                                                ShowIcon="True"
                                                Background="#F3F4F6"
                                                TextColor="Black"
                                                HeightRequest="28"
                                                WidthRequest="28"
                                                Padding="2"
                                                CornerRadius="6"
                                                Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference VouchersDataGrid}}"
                                                CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </syncfusion:DataGridTemplateColumn.CellTemplate>
                                </syncfusion:DataGridTemplateColumn>
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </StackLayout>
                </ScrollView>
                <!-- Busy Overlay -->
                <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#80FFFFFF" ZIndex="99">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                        <Image Source="your_logo.png" WidthRequest="80" HeightRequest="80" Aspect="AspectFit" />
                        <ActivityIndicator IsRunning="True" Color="Gray" WidthRequest="40" HeightRequest="40" />
                    </StackLayout>
                </Grid>
            </Grid>
        </On>
        <On Platform="WinUI">
            <Grid>
                <ScrollView>
                    <StackLayout Padding="40,32,40,32" Spacing="24">
                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Text="Voucher Management System"
                       FontAttributes="Bold"
                       TextColor="Black"
                       FontSize="22"
                       Grid.Column="0"/>
                            <StackLayout Orientation="Horizontal" Grid.Column="1" Spacing="16">
                                <Image Source="bell_icon.png" HeightRequest="24" WidthRequest="24"/>
                                <Image Source="settings_icon.png" HeightRequest="24" WidthRequest="24"/>
                            </StackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="Black" HorizontalOptions="FillAndExpand" Margin="0,8,0,8"/>

                        <!-- Page Title -->
                        <StackLayout>
                            <Label Text="Wheelchair Vouchers" FontAttributes="Bold" FontSize="32" TextColor="Black"/>
                            <Label Text="Manage and track wheelchair assistance vouchers" FontSize="18" TextColor="#6B7280"/>
                        </StackLayout>

                        <!-- Filter Vouchers Card -->
                        <Border Background="#F9FAFB" Stroke="#E5E7EB" StrokeThickness="1" Padding="24" StrokeShape="RoundRectangle 12" Margin="0,0,0,0">
                            <Grid RowSpacing="16" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Filter Title -->
                                <Label Grid.Row="0" Grid.Column="0" Text="Filter Vouchers" FontAttributes="Bold" FontSize="20" TextColor="Black" Grid.ColumnSpan="2"/>

                                <!-- Export/Add Buttons -->
                                <StackLayout Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalOptions="End" Spacing="12">
                                    <syncfusionButtons:SfButton Text="Export CSV" Background="#F3F4F6" TextColor="Black" Padding="16,0" CornerRadius="6" Command="{Binding ExportCommand}"/>
                                    <syncfusionButtons:SfButton Text="Add Voucher" Background="#111111" TextColor="White" Padding="16,0" CornerRadius="6" Command="{Binding AddCommand}"/>
                                </StackLayout>

                                <!-- Search -->
                                <StackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <Label Text="Search" FontSize="16" TextColor="#374151"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <SearchBar
                                Placeholder="Search passengers, employees..."
                                TextColor="Black"
                                PlaceholderColor="#6B7280"
                                BackgroundColor="White"
                                Text="{Binding SearchText, Mode=TwoWay}" />
                                    </Grid>
                                </StackLayout>

                                <!-- Start Date -->
                                <StackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <Label Text="Start Date" FontSize="16" TextColor="#374151"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker BackgroundColor="White" Date="{Binding StartDate,Mode=TwoWay}" TextColor="Black"/>
                                        <Image Grid.Column="1" Source="calendar_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="8,0"/>
                                    </Grid>
                                </StackLayout>

                                <!-- End Date -->
                                <StackLayout Grid.Row="1" Grid.Column="2" Spacing="4">
                                    <Label Text="End Date" FontSize="16" TextColor="#374151"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker BackgroundColor="White" Date="{Binding EndDate}" TextColor="Black"/>
                                        <Image Grid.Column="1" Source="calendar_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="8,0"/>
                                    </Grid>
                                </StackLayout>

                                <!--Airline Filter-->
                                <Picker Grid.Row="1" Grid.Column="3"
                                    ItemsSource="{Binding Airlines}"
                                    SelectedItem="{Binding SelectedAirline, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding Name}"
                                    Title="Select airline"
                                    TextColor="Black"
                                    BackgroundColor="White"/>

                                <!-- Clear Filters Button -->
                                <StackLayout Grid.Row="1" Grid.Column="4"  VerticalOptions="End">
                                    <syncfusionButtons:SfButton Text="Clear Filters" Background="White" TextColor="Black" Padding="16,0" CornerRadius="6">
                                        <syncfusionButtons:SfButton.ImageSource>
                                            <FileImageSource File="filter_icon.png"/>
                                        </syncfusionButtons:SfButton.ImageSource>
                                    </syncfusionButtons:SfButton>
                                </StackLayout>
                            </Grid>
                        </Border>

                        <!-- Vouchers List Card -->
                        <Border Background="#FFFFFF" Stroke="#E5E7EB" StrokeThickness="1" Padding="24" StrokeShape="RoundRectangle 12">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Label Text="{Binding VouchersCount, StringFormat='Vouchers ({0})'}"
                       FontAttributes="Bold"
                       FontSize="20"
                       TextColor="Black"/>
                                <Label Text="List of wheelchair assistance vouchers" FontSize="16" TextColor="#6B7280" Margin="0,0,0,16" Grid.Row="1"/>
                                <syncfusion:SfDataGrid
                        x:Name="VouchersDataGrid2"
                        ItemsSource="{Binding Vouchers}"                        
                        GridLinesVisibility="Horizontal"
                        AutoGenerateColumnsMode="None"
                        ColumnWidthMode="Fill"
                        HeaderGridLinesVisibility="Horizontal"
                        RowHeight="40"
                        SelectionMode="None"
                        Margin="0,0,0,0"
                        Grid.Row="2">
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:DataGridTextColumn HeaderText="Date" MappingName="Date" DisplayBinding="{Binding Path=Date,Converter={StaticResource TickToDateConverter}}"/>
                                        <syncfusion:DataGridTextColumn HeaderText="Passenger" MappingName="PassengerName"/>
                                        <syncfusion:DataGridTextColumn HeaderText="Employee" MappingName="Employee"/>
                                        <syncfusion:DataGridTextColumn HeaderText="Airline" MappingName="Airline"/>
                                        <syncfusion:DataGridTextColumn HeaderText="Flight" MappingName="FullFlightNumber"/>
                                        <syncfusion:DataGridTextColumn HeaderText="Start Time" MappingName="StartTime" DisplayBinding="{Binding Path=StartTime,Converter={StaticResource TicksToStringTimeConverter}}"/>
                                        <syncfusion:DataGridTextColumn HeaderText="End Time" MappingName="EndTime" DisplayBinding="{Binding Path=EndTime, Converter={StaticResource TicksToStringTimeConverter}}"/>
                                        <syncfusion:DataGridTemplateColumn HeaderText="Status" ColumnWidthMode="LastColumnFill" MappingName="Status">
                                            <syncfusion:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                            Padding="4"
                                            Stroke="#E5E7EB"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                                        <Label
                                                Text="{Binding Status, Converter={StaticResource IntToStatusConverter}}"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                TextColor="Black"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </syncfusion:DataGridTemplateColumn.CellTemplate>

                                        </syncfusion:DataGridTemplateColumn>
                                        <syncfusion:DataGridTemplateColumn HeaderText="Actions" ColumnWidthMode="LastColumnFill">
                                            <syncfusion:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                                        <syncfusionButtons:SfButton
                                                ImageSource="edit.png"
                                                ShowIcon="True"
                                                ImageAlignment="Default"
                                                Background="#F3F4F6"
                                                TextColor="Black"
                                                HeightRequest="28"
                                                WidthRequest="28"
                                                Padding="2"
                                                CornerRadius="6"
                                                Command="{Binding Path=BindingContext.EditCommand, Source={x:Reference VouchersDataGrid2}}"
                                                CommandParameter="{Binding .}" />
                                                        <syncfusionButtons:SfButton
                                                ImageSource="trash.png"
                                                ImageAlignment="Default"
                                                ShowIcon="True"
                                                Background="#F3F4F6"
                                                TextColor="Black"
                                                HeightRequest="28"
                                                WidthRequest="28"
                                                Padding="2"
                                                CornerRadius="6"
                                                Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference VouchersDataGrid2}}"
                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </syncfusion:DataGridTemplateColumn.CellTemplate>
                                        </syncfusion:DataGridTemplateColumn>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>
                            </Grid>
                        </Border>
                    </StackLayout>
                </ScrollView>
                <!-- Busy Overlay -->
                <Grid IsVisible="{Binding IsBusy}"
      BackgroundColor="#80FFFFFF"
      ZIndex="99">

                    <StackLayout HorizontalOptions="Center"
                 VerticalOptions="Center"
                 Spacing="20">

                        <!-- Logo -->
                        <Image Source="your_logo.png"
               WidthRequest="100"
               HeightRequest="100"
               Aspect="AspectFit" />

                        <!-- Spinner -->
                        <ActivityIndicator IsRunning="True"
                           IsVisible="True"
                           Color="Gray"
                           WidthRequest="50"
                           HeightRequest="50" />
                    </StackLayout>
                </Grid>
            </Grid>
        </On>
    </OnPlatform>
</ContentPage>