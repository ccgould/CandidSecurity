<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CandidQVmMulti.Controls.QuickActionCard"
             x:Name="Root">

    <Border Background="#F8FAFC"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            Padding="20"
            StrokeShape="RoundRectangle 12">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>

        <StackLayout>
            <Label Text="{Binding Title, Source={x:Reference Root}}"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="Black"/>
            <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
                   FontSize="14"
                   TextColor="#6B7280"/>
        </StackLayout>
    </Border>
</ContentView>