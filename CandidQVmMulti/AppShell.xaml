<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CandidQVmMulti"
    xmlns:pages="clr-namespace:CandidQVmMulti.View.Pages"
    x:Class="CandidQVmMulti.AppShell"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:converters="clr-namespace:CandidQVmMulti.View.Converters"
    BackgroundColor="#F8FAFC"
    FlyoutBackgroundColor="#323645"
    Shell.FlyoutBehavior="Locked"
    Shell.FlyoutWidth="250"
    x:Name="shell">

    <Shell.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter  x:Key="BoolToColorConverter"/>
            <converters:BoolToMenuItemColorConverter  x:Key="BoolToMenuItemColorConverter"/>

            
            <!-- Define FontImageSource -->
            <FontImageSource x:Key="HomeIcon"
                             Glyph="&#xf015;"
                FontFamily="FASolid"
                             Size="20"
                             Color="#6e718c" />
            <!-- Define FontImageSource -->
            <FontImageSource x:Key="VoucherIcon"
                             Glyph="&#xf15c;"
                FontFamily="FASolid"
                             Size="20"
                             Color="#6e718c" />
            <!-- Define FontImageSource -->
            <FontImageSource x:Key="EmployeeIcon"
                             Glyph="&#xf007;"
                FontFamily="FASolid"
                             Size="20"
                             Color="#6e718c" />
            <!-- Define FontImageSource -->
            <FontImageSource x:Key="AirlineIcon"
                             Glyph="&#xf072;"
                FontFamily="FASolid"
                             Size="20"
                             Color="#6e718c" />
        </ResourceDictionary>
    </Shell.Resources>

        
    <!--<Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="10">
                <HorizontalStackLayout Spacing="20">
                    <Image Source="{Binding Icon}" HeightRequest="15" WidthRequest="15"/>
                    <Label Text="{Binding Title}"
                       TextColor="#6e718c"
                       FontSize="16"
                       VerticalOptions="Center" />
                </HorizontalStackLayout>

            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>-->

    <Shell.FlyoutContentTemplate>
        <DataTemplate>
            <Grid RowDefinitions="Auto,Auto,*, 60" RowSpacing="10">
                <VerticalStackLayout Grid.Row="0">
                    <Label Text="Administration"
                           Margin="30,20,20,20"
                           TextColor="#6e718c" />

                    <!-- Dynamic Menu Items -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FlyoutItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10"  BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference shell}, Path=BindingContext.NavigateCommand}"
                                                              CommandParameter="{Binding}" />
                                    </Grid.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="20" Margin="30,0,0,0">
                                        <Image HeightRequest="15" WidthRequest="15">
                                            <Image.Source>
                                                <FontImageSource
                                                     Glyph="{Binding IconGlyph}"
                                                     FontFamily="FASolid"
                                                     Size="15"
                                                     Color="#6e718c" />
                                            </Image.Source>
                                        </Image>
                                        <Label Text="{Binding Title}"
                                               TextColor="{Binding IsSelected, Converter={StaticResource BoolToMenuItemColorConverter}}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Margin="30,20,20,20" Spacing="20">
                    <Label Text="Information" TextColor="#6e718c" />
                    
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                        <Label Text="Vouchers Signed"
                           TextColor="#6e718c" />
                        <Label Text="50/100" TextColor="#6e718c" Grid.Column="1" />
                        <ProgressBar Progress=".5" Grid.Row="1" Grid.ColumnSpan="2" ProgressColor="#37c5de"/>
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                        <Label Text="Vouchers Signed"
                           TextColor="#6e718c" />
                        <Label Text="50/100" TextColor="#6e718c" Grid.Column="1" />
                        <ProgressBar Progress=".5" Grid.Row="1" Grid.ColumnSpan="2" ProgressColor="#37c5de"/>
                    </Grid>
                </VerticalStackLayout>

                <Grid BackgroundColor="#262931" Grid.Row="2">
                    <Label Text="Projects"
                     Margin="30,20,20,20"
                     TextColor="#6e718c" />
                </Grid>

                <VerticalStackLayout Grid.Row="3" VerticalOptions="Center" HorizontalOptions="Center"> 
                    <Label Text="Copyright Creswell Gould 2025" TextColor="#6e718c" FontSize="10" />
                    <Label Text="All Rights Reserved." TextColor="#6e718c" FontSize="10"/>

                </VerticalStackLayout>
            </Grid>

        </DataTemplate>
    </Shell.FlyoutContentTemplate>


    <FlyoutItem Title="Dashboard" Icon="{StaticResource HomeIcon}">
        <ShellContent ContentTemplate="{DataTemplate pages:MainPage}" Route="MainPage"/>
    </FlyoutItem>
    <FlyoutItem Title="Vouchers" Icon="{StaticResource VoucherIcon}">
        <ShellContent ContentTemplate="{DataTemplate pages:VouchersPage}" Route="VouchersPage"/>
    </FlyoutItem>
    <FlyoutItem Title="Employees" Icon="{StaticResource EmployeeIcon}">
        <ShellContent ContentTemplate="{DataTemplate pages:EmployeesPage}" Route="EmployeesPage"/>
    </FlyoutItem>
    <FlyoutItem Title="Airlines" Icon="{StaticResource AirlineIcon}">
        <ShellContent ContentTemplate="{DataTemplate pages:AirlinesPage}" Route="AirlinesPage"/>
    </FlyoutItem>
    
    
</Shell>
