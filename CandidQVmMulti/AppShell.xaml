<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CandidQVmMulti"
    xmlns:pages="clr-namespace:CandidQVmMulti.View.Pages"
    x:Class="CandidQVmMulti.AppShell"
    BackgroundColor="#F8FAFC"
    FlyoutBackgroundColor="White"
    FlyoutWidth="60"
    Shell.FlyoutBehavior="Locked">

    <FlyoutItem Title="Dashboard" Icon="dashboard.png">
        <ShellContent ContentTemplate="{DataTemplate pages:MainPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Vouchers" Icon="voucher.png">
        <ShellContent ContentTemplate="{DataTemplate pages:VouchersPage}" />
    </FlyoutItem>
    <!--<FlyoutItem Title="Add Voucher" Icon="plus.png">
        <ShellContent ContentTemplate="{DataTemplate pages:AddVoucherPage}" />
    </FlyoutItem>-->
    <FlyoutItem Title="Employees" Icon="employees.png">
        <ShellContent ContentTemplate="{DataTemplate pages:EmployeesPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Airlines" Icon="plane.png">
        <ShellContent ContentTemplate="{DataTemplate pages:AirlinesPage}" />
    </FlyoutItem>
</Shell>
